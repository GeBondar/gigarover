[Unit]
Description=GIGAROVER ROS 2 bringup
# VESC-узел стека — мост к rover-motord: тянем демона и стартуем после него.
# Мост переживает отсутствие демона (valid=false + диагностика ERROR),
# поэтому Wants=, а не Requires=.
After=network-online.target rover-motord.service
Wants=network-online.target rover-motord.service
Conflicts=rover-setup-web.service

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/rover_ws
EnvironmentFile=-/etc/default/rover-bringup
ExecStart=/bin/bash -lc 'set -e; cd "${ROVER_WS:-.}"; source /opt/ros/jazzy/setup.bash; source install/setup.bash; exec ros2 launch rover_bringup robot.launch.py profile:="${ROVER_PROFILE:-gigarover}" discovery_mode:="${ROVER_DISCOVERY_MODE:-configured}" ${ROVER_LAUNCH_ARGS:-}'
Restart=on-failure
RestartSec=5
KillSignal=SIGINT
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
