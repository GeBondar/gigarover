# Настройки служб rover-bringup и rover-setup-web.
#
# Этот файл устанавливается в /etc/default/rover-bringup скриптом
# deploy/systemd/install.sh (пути подставляются автоматически).
# Правьте установленную копию на ровере, затем:
#
#   sudo systemctl restart rover-bringup

# ROS workspace, в котором лежит install/setup.bash.
ROVER_WS=/home/ubuntu/rover_ws

# Каталог пользовательских конфигов: сюда rover-setup-web экспортирует
# motors.yaml, отсюда bringup его подхватывает.
ROVER_CONFIG_DIR=/home/ubuntu/rover_config

# Профиль запуска из rover_bringup/config/profiles.
ROVER_PROFILE=gigarover

# Режим поиска serial-устройств: configured, verify или full.
ROVER_DISCOVERY_MODE=configured

# Опциональные настройки ROS.
ROS_DOMAIN_ID=0
RMW_IMPLEMENTATION=rmw_fastrtps_cpp

# Дополнительные аргументы robot.launch.py.
# Примеры:
#   ROVER_LAUNCH_ARGS="use_camera:=false"
#   ROVER_LAUNCH_ARGS="profile:=gigarover_navigation"
ROVER_LAUNCH_ARGS=
