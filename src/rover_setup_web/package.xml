<?xml version="1.0"?>
<package format="3">
  <name>rover_setup_web</name>
  <version>0.1.0</version>
  <description>Standalone Flask web app for first-time VESC/CAN drivetrain setup: scan, identify, assign wheels, drive test, export motors.yaml.</description>
  <maintainer email="maintainer@example.com">Rover Team</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>python3-flask</exec_depend>
  <exec_depend>python3-can</exec_depend>
  <exec_depend>python3-serial</exec_depend>
  <export><build_type>ament_python</build_type></export>
</package>
